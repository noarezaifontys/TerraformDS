    {
      "mode": "managed",
      "type": "kubernetes_config_map",
      "name": "logstash_config2",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "binary_data": {},
            "data": {
              "logstash.conf": "      input {\r\n        beats {\r\n          port =\u003e 5044\r\n        }\r\n\r\n        syslog {\r\n          port  =\u003e 5514\r\n          codec =\u003e line\r\n        }\r\n      }\r\n\r\n      filter {\r\n        if [fields][app] {\r\n          mutate {\r\n            add_field =\u003e {\r\n              \"app\" =\u003e \"%{[fields][app]}\"\r\n            }\r\n          }\r\n        }\r\n\r\n        # GROK patroon voor standaard Keycloak-logs\r\n        if \"keycloak\" in [app] {\r\n          grok {\r\n            match =\u003e {\r\n              \"message\" =\u003e [\r\n                \"%{TIMESTAMP_ISO8601:timestamp} %{LOGLEVEL:log_level}  \\\r\n\r\n\\[%{DATA:logger}\\\\]\r\n\r\n \\\\(%{DATA:thread}\\\\) %{GREEDYDATA:log_message}\"\r\n              ]\r\n            }\r\n          }\r\n\r\n          date {\r\n            match  =\u003e [\"timestamp\", \"yyyy-MM-dd HH:mm:ss,SSS\"]\r\n            target =\u003e \"@timestamp\"\r\n          }\r\n        }\r\n      }\r\n\r\n      output {\r\n        stdout {\r\n          codec =\u003e rubydebug\r\n        }\r\n\r\n        elasticsearch {\r\n          hosts =\u003e [\"http://elasticsearch:9200\"]\r\n          index =\u003e \"logstash-%{+YYYY.MM.dd}\"\r\n        }\r\n      }\r\n"
            },
            "id": "default/logstash-pipeline-config",
            "immutable": false,
            "metadata": [
              {
                "annotations": {},
                "generate_name": "",
                "generation": 0,
                "labels": {},
                "name": "logstash-pipeline-config",
                "namespace": "default",
                "resource_version": "54904",
                "uid": "d660cfc7-917a-4598-aa3a-146afce5df21"
              }
